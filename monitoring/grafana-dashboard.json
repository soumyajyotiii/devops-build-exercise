{
  "dashboard": {
    "title": "Underwriting Agent — Overview",
    "uid": "underwriting-agent-overview",
    "tags": ["underwriting-agent", "production"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "constant",
          "current": { "value": "underwriting-agent" }
        }
      ]
    },
    "panels": [
      {
        "title": "Request Rate (items/min)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", handler=\"/v1/items/process\"}[5m])) * 60",
            "legendFormat": "requests/min"
          }
        ]
      },
      {
        "title": "Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", handler=\"/v1/items/process\"}[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", handler=\"/v1/items/process\"}[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", handler=\"/v1/items/process\"}[5m])) by (le))",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 5, "color": "yellow" },
                { "value": 8, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "title": "Error Rate (%)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"$namespace\"}[5m])) * 100",
            "legendFormat": "error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 0.5, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "title": "LLM Call Latency (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(llm_call_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le, model))",
            "legendFormat": "{{ model }} p95"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "s" }
        }
      },
      {
        "title": "LLM Calls by Action Type",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum by (action_type) (increase(agent_actions_total{namespace=\"$namespace\"}[24h]))",
            "legendFormat": "{{ action_type }}"
          }
        ]
      },
      {
        "title": "Pod Count & HPA",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}",
            "legendFormat": "current replicas"
          },
          {
            "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"$namespace\"}",
            "legendFormat": "min"
          },
          {
            "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\"}",
            "legendFormat": "max"
          }
        ]
      },
      {
        "title": "CPU Usage per Pod",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"agent\"}[5m])",
            "legendFormat": "{{ pod }}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short" }
        }
      },
      {
        "title": "Memory Usage per Pod",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{namespace=\"$namespace\", container=\"agent\"}",
            "legendFormat": "{{ pod }}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bytes" }
        }
      },
      {
        "title": "Pod Restarts (1h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))",
            "legendFormat": "restarts"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 3, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "title": "Items Processed (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 24 },
        "targets": [
          {
            "expr": "sum(increase(http_requests_total{namespace=\"$namespace\", handler=\"/v1/items/process\", status=\"200\"}[24h]))",
            "legendFormat": "items"
          }
        ]
      },
      {
        "title": "Estimated Cost / Item ($)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 24 },
        "targets": [
          {
            "expr": "avg(llm_cost_per_call_dollars{namespace=\"$namespace\"})",
            "legendFormat": "$/item"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1.0, "color": "yellow" },
                { "value": 1.5, "color": "red" }
              ]
            }
          }
        }
      }
    ]
  }
}
